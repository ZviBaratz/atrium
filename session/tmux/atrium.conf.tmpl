# Atrium managed tmux config. Regenerated on launch — do NOT edit.
# To customize, set "tmux_config_override" in the config dir's config.json.
#
# Atrium runs its sessions on a dedicated tmux socket (tmux -L) started with this
# file (-f), so the host ~/.tmux.conf is never sourced. Everything Atrium relies
# on is therefore set explicitly below.
#
# This file is rendered from atrium.conf.tmpl at startup; the status-bar block is
# included only when the session context bar is enabled (config session_context_bar).

# Stable, human-readable window names (never auto-rename from the running program).
set-option -g  allow-rename       off
set-option -g  automatic-rename   off
set-window-option -g automatic-rename off

# Terminal (outer) title: identify the session as an Atrium one. Driven by the
# @atrium_name user option Atrium pushes per session; falls back to the raw tmux
# session name before the first metadata tick. This is independent of the in-pane
# status bar below, so the tab still reads "Atrium · <name>" even with the bar off.
set-option -g  set-titles         on
set-option -g  set-titles-string  "Atrium · #{?@atrium_name,#{@atrium_name},#{session_name}}"

# Scrollback + mouse (cs used to set these per-session after creation; now global).
set-option -g  history-limit      10000
set-option -g  mouse              on

# Prefix-free keyboard scrollback. Sessions run on this isolated socket, so none of
# the host ~/.tmux.conf's scroll chords exist here and the only keyboard route into
# the history is tmux's default `prefix PageUp` — a chord whose prefix (C-b) is also
# Claude Code's "background this task" key, which is why its docs tell tmux users to
# press C-b twice. Shift+PageUp is the terminal-native chord for the same intent and
# collides with nothing the agents bind; Alt+PageUp is the common host spelling, kept
# as an alias so muscle memory from a personal config carries over.
#
# -u enters copy mode already scrolled one page back, so a single press scrolls. -e
# leaves copy mode again as soon as you page back to the bottom, so scrolling can
# never strand a pane in a mode that eats the next keystroke sent to it — copy mode
# consumes send-keys, including the autoyes daemon's Enter and a queued prompt.
#
# Ctrl+PageUp/PageDown are deliberately NOT used: the attach layer intercepts them
# for sibling-session cycling (navReason in detach.go) before tmux ever sees them.
# An agent that draws on the alternate screen (Claude Code's fullscreen renderer,
# and anything else vim-like) accumulates NO tmux history, so entering copy mode
# there yields an empty `[0/0]` view and swallows the keypress. Hand the chord to
# the agent instead and let it scroll its own conversation — the same test tmux's
# own default wheel binding makes. On a normal pane the else-branch runs and copy
# mode works as below.
bind-key -n S-PPage if-shell -F '#{alternate_on}' 'send-keys S-PPage' { copy-mode -eu }
bind-key -n M-PPage if-shell -F '#{alternate_on}' 'send-keys M-PPage' { copy-mode -eu }
bind-key -T copy-mode-vi S-PPage send-keys -X page-up
bind-key -T copy-mode-vi S-NPage send-keys -X page-down
bind-key -T copy-mode-vi M-PPage send-keys -X page-up
bind-key -T copy-mode-vi M-NPage send-keys -X page-down

# Line-granular scrolling, for the reason a scrollbar beats a page key: a page jump
# loses your place. shift-up/down move one line and hold-to-repeat turns that into
# continuous motion (40 repeats land 40 lines, nothing dropped), which is what makes
# scrolling feel smooth rather than stepped. They pair with the page keys above —
# page to the right region, then nudge.
#
# `copy-mode -e` here deliberately omits the -u the page bindings use: entering at
# the bottom is what keeps the first nudge one line instead of a page. scroll-up
# moves the view and leaves the cursor, unlike vi's j/k, which move the cursor and
# only scroll once it hits an edge.
bind-key -n S-Up   if-shell -F '#{alternate_on}' 'send-keys S-Up'   { copy-mode -e ; send-keys -X scroll-up }
bind-key -n S-Down if-shell -F '#{alternate_on}' 'send-keys S-Down' { copy-mode -e ; send-keys -X scroll-down }
bind-key -T copy-mode-vi S-Up   send-keys -X scroll-up
bind-key -T copy-mode-vi S-Down send-keys -X scroll-down

# One wheel notch travels 3 lines rather than tmux's default 5, so a pane scrolls the
# same distance per notch as the preview pane does in the TUI (wheelScrollLines).
bind-key -T copy-mode-vi WheelUpPane   select-pane \; send-keys -X -N 3 scroll-up
bind-key -T copy-mode-vi WheelDownPane select-pane \; send-keys -X -N 3 scroll-down

# vi copy mode: g/G, j/k, C-u/C-d and / search come free with mode-keys, but tmux's
# vi defaults bind v to rectangle-toggle and leave y unbound — so mode-keys alone
# would make the muscle-memory v/y do the wrong thing rather than nothing. Rectangle
# select moves to C-v, as in vim; r keeps tmux's own refresh-from-pane.
set-window-option -g mode-keys    vi
bind-key -T copy-mode-vi v   send-keys -X begin-selection
bind-key -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind-key -T copy-mode-vi y   send-keys -X copy-selection-and-cancel

# Make tmux's own copy reach the system clipboard via OSC 52, even though the
# tmux-256color terminfo lacks an Ms entry. Without this, mouse / copy-mode
# selections land only in a tmux paste buffer and never update the OS clipboard,
# so a paste returns stale content. set-clipboard on also lets programs running
# in the pane set the clipboard.
#
# The value is double-quoted, so tmux's config lexer processes the escapes: ESC and
# BEL MUST be written as 3-digit octal (\033, \007). A 1-digit octal like \7 is a
# hard "invalid octal escape" parse error on tmux, and \E yields a literal 'E', not
# ESC — either one silently or fatally breaks the OSC 52 sequence.
set-option -g  set-clipboard      on
set-option -ga terminal-overrides ",*:Ms=\033]52;%p1%s;%p2%s\007"

{{if .ContextBar -}}
# In-session context as a single, minimal top header carrying session identity
# (<glyph> <repo> · <name>), drawn at the very top so it stays clear of the agent's
# own bottom footer. There is deliberately no bottom strip: the agent owns the pane
# and draws directly under its own footer.
#
# Atrium owns all formatting/coloring: it pushes a fully-rendered string into
# @atrium_left via set-option on each metadata tick, then refresh-client -S repaints.
# status-interval 0 means tmux never refreshes on its own — Atrium drives every
# update. The window list is blanked because each Atrium session is a single window,
# and status-right is emptied so tmux's default clock never appears.
#
# status-style fills the whole row with the theme's elevated-surface color so the
# header reads as a distinct band, not text floating over the agent's pane. The
# @atrium_left markup only sets foregrounds, so #[default] resets back to this band
# background, keeping the fill unbroken across every field.
set-option -g  status              on
set-option -g  status-position     top
set-option -g  status-interval     0
set-option -g  status-justify      left
set-option -g  status-style        "bg={{.BarBg}},fg={{.BarFg}}"
set-option -g  status-left-length  400
set-option -g  status-right-length 0
set-window-option -g window-status-format        ""
set-window-option -g window-status-current-format ""
set-option -g  status-left         " #{@atrium_left} "
set-option -g  status-right        ""
set-option -g  pane-border-status  off
{{- else -}}
# No status bar — each session is a single fullscreen pane and the agent draws its
# own UI, so tmux chrome is pure noise (session_context_bar = false).
set-option -g  status             off
set-option -g  pane-border-status off
{{- end}}

# Color fidelity: cs captures pane content with -e (ANSI preserved) and re-renders
# it, so the isolated server must advertise 256-color + truecolor passthrough.
set-option -g  default-terminal   "tmux-256color"
set-option -ga terminal-overrides ",*:Tc"

# Predictable behavior regardless of host preferences.
set-option -g  base-index         0
set-window-option -g pane-base-index 0
set-option -sg escape-time        10
set-option -g  destroy-unattached off
set-option -g  remain-on-exit     off
