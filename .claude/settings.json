{
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "charm-tui@zvibaratz": true
  },
  "permissions": {
    "allow": [
      "Bash(just:*)",
      "Bash(go:*)",
      "Bash(golangci-lint:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(gopls:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh auth status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(shellcheck:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-through-just.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/drift-sites-advisory.sh"
          }
        ]
      }
    ]
  }
}
